# Copied to ~/.config/gdrive-sync/config.env by install.sh. Edit that copy.
LOCAL_DIR="$HOME/Documents/eagle-vision"
REMOTE="gdrive:TN Documents"          # rclone remote:path (remote must already exist)
MAX_DELETE=25                          # abort a run that would delete more than this many files
NOTIFY_AFTER_FAILURES=5                # desktop notification after N consecutive failed runs
